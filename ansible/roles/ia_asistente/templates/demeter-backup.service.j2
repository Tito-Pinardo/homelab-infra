[Unit]
Description=Demeter: copia SQLite y prueba de restauracion local

[Service]
Type=oneshot
User=demeter
Group=demeter
UMask=0077
ExecStart=/usr/bin/python3 /opt/demeter/demeter_backup.py --db /var/lib/demeter/queue.sqlite --directory /var/lib/demeter/backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/demeter
RestrictAddressFamilies=AF_UNIX

