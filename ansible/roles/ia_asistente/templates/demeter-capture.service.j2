[Unit]
Description=Demeter: capturar compras de correo en bandeja de revision
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=demeter
Group=demeter
UMask=0077
EnvironmentFile=/etc/demeter.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/demeter/demeter_mail.py --db /var/lib/demeter/queue.sqlite --reconcile --limit {{ demeter_capture_limit | default(100) | int }}
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/demeter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
