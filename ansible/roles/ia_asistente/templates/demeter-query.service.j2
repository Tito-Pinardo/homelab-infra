[Unit]
Description=Demeter: consultas locales de solo lectura para Hermes
After=demeter-web.service

[Service]
User=demeter
Group=ia-bot
SupplementaryGroups=demeter
RuntimeDirectory=demeter-query
RuntimeDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/demeter/demeter_query_server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite en modo WAL: una conexion de SOLO LECTURA necesita igualmente el
# fichero -shm (indice compartido). Con el directorio en ReadOnlyPaths
# fallaba con "unable to open database file" siempre que no hubiera un
# escritor vivo manteniendo ese -shm, asi que Hermes respondia "Demeter no
# esta disponible" a intervalos, sin dejar rastro (2026-09-22).
# La garantia de no escribir NO depende de esto: la conexion se abre con
# mode=ro y PRAGMA query_only=ON, y el codigo solo hace SELECT.
ReadWritePaths=/var/lib/demeter
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
