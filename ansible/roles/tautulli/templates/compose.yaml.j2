# Generado por Ansible (roles/tautulli): no editar a mano, se sobrescribe.
services:
  tautulli:
    image: lscr.io/linuxserver/tautulli:latest
    container_name: tautulli
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Madrid
    volumes:
      - /opt/stacks/tautulli/data:/config
    ports:
      - 8181:8181
    restart: unless-stopped
