{# El cert wildcard pedido aqui (main+sans) queda en el almacen de Traefik y
   lo REUTILIZAN automaticamente, por coincidencia de SNI, todos los demas
   routers "tls: {}" de ese mismo dominio (ver traefik_routes) - por eso el
   109 real solo tiene 1 certificado en acme.json cubriendo 25 subdominios,
   no uno por cada router. #}
{% set wildcard_domains = traefik_domains | default([]) | selectattr('wildcard') | list %}
http:
  routers:
    traefik_dashboard:
      rule: Host(`{{ traefik_dashboard_host }}`)
      entryPoints: [websecure]
      service: api@internal
      tls:
        certResolver: letsencrypt
{% if wildcard_domains %}
        domains:
{% for d in wildcard_domains %}
          - main: "{{ d.domain }}"
            sans:
              - "*.{{ d.domain }}"
{% endfor %}
{% endif %}
{# El bouncer tambien aqui (solo LAN, nunca bloquea): asi el plugin se carga
   y se conecta a CrowdSec aunque no este activo en las rutas publicas. #}
      middlewares: [{% if traefik_crowdsec | default(false) %}crowdsec@file, {% endif %}auth{% if traefik_dashboard_allowed_ips | default([]) %}, dashboard_lan{% endif %}]

  middlewares:
{% if traefik_dashboard_allowed_ips | default([]) %}
    dashboard_lan:
      ipAllowList:
        sourceRange: {{ traefik_dashboard_allowed_ips | to_json }}
{% endif %}
    auth:
      basicAuth:
        users:
          - "{{ traefik_dashboard_htpasswd }}"
