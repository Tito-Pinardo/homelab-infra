{# Bloques compartidos referenciados desde traefik_routes (ej. sec_headers@file). #}
http:
  middlewares:
    sec_headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: "no-referrer-when-downgrade"

    registry_buffering:
      buffering:
        maxRequestBodyBytes: 0
        memRequestBodyBytes: 0
        maxResponseBodyBytes: 0
        memResponseBodyBytes: 0

    amp_headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        contentTypeNosniff: true
        frameDeny: false
        customFrameOptionsValue: "SAMEORIGIN"
        referrerPolicy: "no-referrer-when-downgrade"

    keycloak_headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        contentTypeNosniff: true
        frameDeny: false
        referrerPolicy: "no-referrer-when-downgrade"

    forwarded_headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
          X-Forwarded-Port: "443"
{% if traefik_crowdsec | default(false) %}

    # Bouncer de CrowdSec (docs/crowdsec.md). En modo stream: trae las
    # decisiones del LAPI cada minuto y decide en memoria; si CrowdSec cae,
    # sigue con las ultimas que tenia.
    crowdsec:
      plugin:
        crowdsec:
          enabled: true
          crowdsecMode: stream
          crowdsecLapiScheme: http
          crowdsecLapiHost: 127.0.0.1:8080
          crowdsecLapiKeyFile: /etc/traefik/crowdsec-lapi.key
          updateIntervalSeconds: 60
          forwardedHeadersTrustedIPs: {{ traefik_ips_confiables | default([]) | to_json }}
          clientTrustedIPs: {{ crowdsec_ips_casa | to_json }}
{% endif %}
