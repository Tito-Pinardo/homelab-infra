{% if traefik_cloudflare_api_token is defined %}
{# CF_DNS_API_TOKEN es la variable que lee lego/Traefik para el provider
   cloudflare. CLOUDFLARE_DNS_API_TOKEN se define tambien por compatibilidad. #}
CF_DNS_API_TOKEN={{ traefik_cloudflare_api_token }}
CLOUDFLARE_DNS_API_TOKEN={{ traefik_cloudflare_api_token }}
{% else %}
# placeholder - sin token real, ACME fallara y es esperado en este grupo
{% endif %}
