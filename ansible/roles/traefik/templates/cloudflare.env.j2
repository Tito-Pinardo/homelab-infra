{% if traefik_cloudflare_api_token is defined %}
{# CF_DNS_API_TOKEN es la variable que realmente lee lego/Traefik para el
   provider "cloudflare" (scoped API Token). CLOUDFLARE_DNS_API_TOKEN no la
   usa Traefik, pero el 109 real la define también - se replica igual por
   si algo más la depende, sin coste real. #}
CF_DNS_API_TOKEN={{ traefik_cloudflare_api_token }}
CLOUDFLARE_DNS_API_TOKEN={{ traefik_cloudflare_api_token }}
{% else %}
# placeholder - sin token real, ACME fallara y es esperado en este grupo
{% endif %}
