# Generado por Ansible (role landing) - contiene secretos, 0640 root:landing.
BIND_ADDR=0.0.0.0:{{ landing_port }}
# Socket local con autenticacion peer: sin contraseña de base de datos. El
# usuario va explicito (sqlx no lo toma del sistema operativo) y "localhost"
# es solo nominal: host=/var/run/postgresql hace que use el socket.
DATABASE_URL=postgres://{{ landing_user }}@localhost/landing?host=/var/run/postgresql
DB_MAX_CONNECTIONS=8
IP_HASH_SALT={{ landing_ip_hash_salt }}
TRUST_PROXY_HEADERS=true
PUBLIC_URL={{ landing_public_url }}
GITHUB_USER={{ landing_github_user }}
HOMELAB_STATUS_FILE={{ landing_dir }}/estado/homelab.json
RUST_LOG=info,tower_http=warn,sqlx=warn
{% if landing_matrix_access_token %}
MATRIX_HOMESERVER={{ landing_matrix_homeserver }}
MATRIX_ACCESS_TOKEN={{ landing_matrix_access_token }}
MATRIX_ROOM_ID={{ landing_matrix_room_id }}
{% endif %}
{% if landing_turnstile_secret %}
TURNSTILE_SITE_KEY={{ landing_turnstile_site_key }}
TURNSTILE_SECRET={{ landing_turnstile_secret }}
{% endif %}
