# Element Web es un SPA con hash-routing (#/...), no rutas de servidor:
# no hace falta el típico "try_files ... /index.html" de otros SPA.
server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /opt/element;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
