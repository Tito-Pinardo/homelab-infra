server {
    listen 8443 ssl;
    server_name paperless.home.example;
    ssl_certificate /etc/nginx/certs/paperless.crt;
    ssl_certificate_key /etc/nginx/certs/paperless.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 200M;
    location / {
        proxy_pass http://127.0.0.1:8000;
        # Sin estas cabeceras Paperless no recibe el aviso en tiempo real de que un
        # documento ha terminado de procesarse.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
