[Unit]
Description=Homepage - dashboard de servicios del homelab
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/homepage
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=NODE_ENV=production
# Sin esto Homepage devuelve 400 "Host validation failed" para cualquier
# Host header que no este en la lista (proteccion propia de Homepage, no de
# Next.js) - hace falta el IP:puerto directo (pruebas en LAN) y el dominio
# publico real detras de Traefik.
Environment=HOMEPAGE_ALLOWED_HOSTS={{ ansible_host }}:3000,homepage.home.arpa
ExecStart=/usr/bin/node /opt/homepage/server.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
