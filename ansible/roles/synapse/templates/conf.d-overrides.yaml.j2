# Gestionado por Ansible (roles/synapse) - se sobreescribe en cada run.
# El resto de /etc/matrix-synapse/homeserver.yaml (signing key, secretos) lo
# genera el paquete Debian una sola vez al instalar y AQUI NO SE TOCA.

database:
  name: psycopg2
  args:
    user: {{ synapse_db_user }}
    password: "{{ synapse_db_password }}"
    database: {{ synapse_db_name }}
    host: 127.0.0.1
    cp_min: 5
    cp_max: 10

# Detras de Traefik: HTTP simple en localhost, x_forwarded para que Synapse
# vea el esquema/IP real que reenvia el proxy (igual que forwardedHeaders en
# el traefik.yaml del rol traefik).
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client]
        compress: false

enable_registration: {{ synapse_enable_registration | lower }}
registration_shared_secret: "{{ synapse_registration_shared_secret }}"

# Privado: sin federacion con otros homeservers. Con la whitelist vacia,
# Synapse rechaza cualquier intento de otro servidor de hablar con este.
federation_domain_whitelist: []

report_stats: false
