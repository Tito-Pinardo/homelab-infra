# Panel de agentes IA (Codeman): solo desde la red local y siempre detras de
# Authelia. El firewall del CT solo acepta su puerto desde este Caddy.
#
# La contrasena de Codeman la pone Caddy tras pasar Authelia: Codeman limita
# los fallos por IP y aqui todo llega desde la IP de Caddy.
agents.home.example {
    tls internal
    route {
        @fuera not remote_ip {{ caddy_redes_permitidas }}
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip {{ caddy_entrada_publica }}
        respond @entrada_publica "Solo red local" 403
        import protected
        reverse_proxy 192.0.2.21:8765 {
            header_up Authorization "Basic {{ ('admin:' ~ hostvars['agents'].agents_codeman_password) | b64encode }}"
        }
    }
}
