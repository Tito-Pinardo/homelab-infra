# Generado por Ansible (roles/arr_stack) - no editar a mano, se sobreescribe.
{
{% if caddy_ca_casa %}
    # Certificados de la CA de casa (OpenBao) por ACME: docs/ca-casa.md.
    acme_ca {{ ca_casa_acme }}
    acme_ca_root {{ ca_casa_acme_raiz_caddy }}
{% else %}
    local_certs
{% endif %}
}

(protected) {
    forward_auth localhost:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
}

