# IPTV: web de Dispatcharr (CT 124). Solo LAN/WireGuard y Authelia 2FA
# (segunda capa sobre su propio login). Las listas M3U/Xtream y los streams
# NO pasan por aqui: Plex y las apps de la tele van directas a
# 192.0.2.244:9191 (no se fian del certificado interno de Caddy).
iptv.home.arpa {
{% if not caddy_ca_casa %}
    tls internal
{% endif %}
    route {
        @fuera not remote_ip 192.0.2.0/24 198.51.100.0/24 127.0.0.1 ::1
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip 192.0.2.6
        respond @entrada_publica "Solo red local" 403
        import protected
        reverse_proxy {{ hostvars['iptv'].ansible_host }}:{{ hostvars['iptv'].iptv_port }}
    }
}

# Forgejo (CT 126): copia de infra-tf con CI. Solo LAN/WireGuard, nunca
# desde Traefik, y Authelia 2FA delante de su propio login. El runner del CI
# (CT 127) entra sin Authelia: no tiene navegador, y ante Forgejo se
# identifica con su token. Git por SSH va directo al CT (puerto 2222).
git.home.arpa {
{% if not caddy_ca_casa %}
    tls internal
{% endif %}
    route {
        @fuera not remote_ip 192.0.2.0/24 198.51.100.0/24 127.0.0.1 ::1
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip 192.0.2.6
        respond @entrada_publica "Solo red local" 403
        @runner remote_ip {{ hostvars['forgejo'].forgejo_runner_ip }}
        reverse_proxy @runner {{ hostvars['forgejo'].ansible_host }}:{{ hostvars['forgejo'].forgejo_http_port }}
        import protected
        reverse_proxy {{ hostvars['forgejo'].ansible_host }}:{{ hostvars['forgejo'].forgejo_http_port }}
    }
}

# OpenBao (CT 128): llaves maestras de infra-tf. Solo LAN/WireGuard y
# Authelia 2FA delante de su propio login. Sirve sobre todo para desellarlo
# tras un reinicio. Su certificado es propio y se fija aqui tal cual (lo copia
# playbooks/openbao.yml a monitoring-cas/).
bao.home.arpa {
{% if not caddy_ca_casa %}
    tls internal
{% endif %}
    route {
        @fuera not remote_ip 192.0.2.0/24 198.51.100.0/24 127.0.0.1 ::1
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip 192.0.2.6
        respond @entrada_publica "Solo red local" 403
        import protected
        reverse_proxy https://{{ hostvars['openbao'].ansible_host }}:{{ hostvars['openbao'].openbao_puerto }} {
            transport http {
                tls_server_name {{ hostvars['openbao'].openbao_dominio }}
                tls_trust_pool file {
                    pem_file /config/monitoring-cas/openbao-ca.pem
                }
            }
        }
    }
}

# Panel de agentes IA (Codeman, CT 123). Con acceso
# a todo el homelab: solo LAN/WireGuard, nunca desde Traefik (.6, la unica
# entrada publica), y siempre detras de Authelia 2FA. El firewall del CT
# solo acepta su puerto desde este Caddy.
#
# La contrasena de Codeman la pone Caddy (header_up) tras pasar Authelia:
# Codeman limita 10 fallos/15 min POR IP y aqui todo llega desde la IP de
# Caddy - sin esto el navegador (cada peticion sin credenciales = fallo)
# bloqueaba el panel en segundos ("Too Many Requests", real 2026-09-22), y
# el Basic Auth del navegador chocaria ademas con Authelia (tambien lee
# Authorization). Codeman sigue exigiendola a cualquier otro origen.
agents.home.arpa {
{% if not caddy_ca_casa %}
    tls internal
{% endif %}
    route {
        @fuera not remote_ip 192.0.2.0/24 198.51.100.0/24 127.0.0.1 ::1
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip 192.0.2.6
        respond @entrada_publica "Solo red local" 403
        import protected
        reverse_proxy 192.0.2.237:8765 {
            header_up Authorization "Basic {{ ('admin:' ~ hostvars['agents'].agents_codeman_password) | b64encode }}"
        }
    }
}
