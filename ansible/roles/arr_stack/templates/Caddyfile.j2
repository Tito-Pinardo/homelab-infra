# Monitorizacion: solo LAN, Authelia 2FA y backend HTTPS verificado.
zabbix.home.example {
    tls internal
    route {
        @fuera not remote_ip {{ caddy_redes_permitidas }}
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip {{ caddy_entrada_publica }}
        import protected
        reverse_proxy https://192.0.2.22:443 {
            transport http {
                tls_server_name zabbix.home.example
                tls_trust_pool file {
                    pem_file /config/monitoring-cas/zabbix-ca.pem
                }
            }
        }
    }
}

