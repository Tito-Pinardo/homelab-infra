# Monitorizacion: solo LAN, Authelia 2FA y backend HTTPS verificado.
zabbix.home.arpa {
{% if not caddy_ca_casa %}
    tls internal
{% endif %}
    route {
        @fuera not remote_ip 192.0.2.0/24 198.51.100.0/24 127.0.0.1 ::1
        respond @fuera "Solo red local" 403
        @entrada_publica remote_ip 192.0.2.6 192.0.2.1
        import protected
        reverse_proxy https://192.0.2.240:443 {
            transport http {
                tls_server_name zabbix.home.arpa
                tls_trust_pool file {
                    pem_file /config/monitoring-cas/zabbix-ca.pem
                }
            }
        }
    }
}

