# Generado por Ansible (roles/arr_stack): no editar a mano, se sobrescribe.
{
    local_certs
}

(protected) {
    forward_auth localhost:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
}

# Aplicacion privada, provisionada por playbooks/demeter.yml.
import /config/demeter/*.caddy

