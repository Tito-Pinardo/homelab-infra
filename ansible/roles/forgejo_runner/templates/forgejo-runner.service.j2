# Generado por Ansible (role forgejo_runner) - no editar a mano.
[Unit]
Description=Forgejo Runner (CI)
After=network-online.target
Wants=network-online.target

[Service]
User=runner
Group=runner
WorkingDirectory=/var/lib/forgejo-runner
Environment=HOME=/var/lib/forgejo-runner
ExecStart=/usr/local/bin/forgejo-runner daemon --config /etc/forgejo-runner/config.yml
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
