table inet casa_dns_destino {
 chain entrada {
  type nat hook prerouting priority dstnat; policy accept;
  fib daddr type local udp dport 53 counter redirect to :5300
  fib daddr type local tcp dport 53 counter redirect to :5300
 }
 chain local {
  type nat hook output priority -100; policy accept;
  fib daddr type local udp dport 53 counter redirect to :5300
  fib daddr type local tcp dport 53 counter redirect to :5300
 }
}
